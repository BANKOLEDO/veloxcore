# LLM Configuration (zero-cost default: Ollama with local model)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5

# Server
PORT=3001

# Auth (REQUIRED — generate a random string for production)
JWT_SECRET=your-random-secret-here

# PostgreSQL (Neon, Render, etc.)
# Get a free Neon connection string at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Alternative Providers ---
# To use Groq (free tier - just need API key):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key
# LLM_MODEL=llama3-70b-8192

# To use OpenAI (paid):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_api_key
# LLM_MODEL=gpt-4o-mini

# To use HuggingFace (free inference):
# LLM_BASE_URL=https://api-inference.huggingface.co/v1
# LLM_API_KEY=hf_your_huggingface_token
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
